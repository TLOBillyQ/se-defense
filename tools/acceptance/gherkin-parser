#!/usr/bin/env bash
# acceptance4lua APS parser: gherkin-parser <feature> <json-ir>
# Run from anywhere; the script cd's to the repository root and uses Lua 5.4.
set -euo pipefail
cd "$(dirname "$0")/../.."
. ./tools/pick-lua.sh
LUA="$(pick_lua)"
export ACCEPTANCE_LUA_BIN="$LUA"
exec "$LUA" tools/acceptance/cli/parser.lua "$@"
