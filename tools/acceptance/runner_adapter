#!/usr/bin/env bash
# APS runner-worker for gherkin-mutator (NDJSON on stdin/stdout).
# Run from anywhere; the script cd's to the repository root and uses Lua 5.4.
set -euo pipefail
cd "$(dirname "$0")/../.."
. ./tools/pick-lua.sh
LUA="$(pick_lua)"
export ACCEPTANCE_LUA_BIN="$LUA"
exec "$LUA" tools/acceptance/cli/runner_worker.lua "$@"
